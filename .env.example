# Webloop Studio environment variables
# Copy to .env.local for development. Never commit real values.

# Public site URL, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://webloopstudio.com

# Contact form delivery (optional). The first configured option is used:
#
# 1. Gmail (no third-party service). Needs 2-Step Verification and an app
#    password from https://myaccount.google.com/apppasswords.
# CONTACT_RECEIVER_EMAIL=you@example.com
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
#
# 2. Resend (https://resend.com). CONTACT_FROM_EMAIL must use a domain verified
#    in Resend; the default onboarding@resend.dev sender only works for testing.
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_FROM_EMAIL="Webloop Studio <hello@webloopstudio.com>"
#
# With neither configured, inquiries are logged to the server console.
