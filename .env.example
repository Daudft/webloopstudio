# Webloop Studio environment variables
# Copy to .env.local for development. Never commit real values.

# Public site URL, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://webloopstudio.com

# Contact form delivery (optional).
# When both RESEND_API_KEY and CONTACT_RECEIVER_EMAIL are set, inquiries are
# emailed via Resend (https://resend.com). Otherwise they are logged to the
# server console. CONTACT_FROM_EMAIL must use a domain verified in Resend;
# the default onboarding@resend.dev address only works for testing.
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_RECEIVER_EMAIL=you@example.com
# CONTACT_FROM_EMAIL="Webloop Studio <hello@webloopstudio.com>"
